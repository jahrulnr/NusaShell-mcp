{
  "id": "nusashell.kanban",
  "name": "Kanban",
  "version": "1.0.0",
  "icon": "file://icon.png",
  "ui": {
    "entry": "ui/index.html",
    "window": {
      "mode": "fullscreen",
      "defaultSize": {
        "width": 1200,
        "height": 800
      },
      "resizable": true
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "node",
    "args": [
      "mcp/server.cjs"
    ],
    "env": {},
    "autostart": false,
    "keepAliveOnClose": false
  },
  "dependencies": {
    "shell": ">=0.1.1"
  },
  "category": "Productivity"
}
