{
  "id": "nusashell.whatsapp",
  "name": "WhatsApp",
  "version": "0.3.0",
  "icon": "file://icon.png",
  "ui": {
    "entry": "ui/index.html",
    "window": {
      "mode": "panel",
      "defaultSize": {
        "width": 520,
        "height": 640
      },
      "resizable": true
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "mcp/server",
    "args": [],
    "env": {},
    "autostart": false,
    "keepAliveOnClose": true
  },
  "automation": {
    "emits": [
      {
        "type": "whatsapp.message_received",
        "description": "A new inbound WhatsApp message was received and stored",
        "payloadSchema": {
          "type": "object",
          "properties": {
            "chat_id": { "type": "string" },
            "chat_jid": { "type": "string" },
            "chat_type": { "type": "string" },
            "message_id": { "type": "string" },
            "sender_id": { "type": "string" },
            "sender_jid": { "type": "string" },
            "text": { "type": "string", "maxLength": 200 },
            "kind": { "type": "string" },
            "from_me": { "type": "boolean" }
          },
          "required": ["chat_id", "chat_jid", "chat_type", "message_id", "sender_id", "sender_jid", "text", "kind", "from_me"]
        }
      }
    ]
  },
  "contract": {
    "entry": "CONTRACT.md"
  },
  "dependencies": {
    "shell": ">=0.1.0"
  },
  "category": "Communication"
}
